model Notice, storage: :memory, expires_in: 1.minute do
  attribute :body, :string
  attribute :occurredAt, :date
  scope :recent do
    order occurredAt: :desc
    subscribe "BulletinAdded"
  end
end

model InteractionNotice, storage: :memory, expires_in: 1.minute do
  attribute :recordId, :id
  attribute :actorUserId, :id
  attribute :occurredAt, :date
  scope :recent do
    order occurredAt: :desc
    subscribe "RecordSignal"
  end
end

model ChatAction, storage: :memory, expires_in: 8.seconds do
  attribute :chatId, :id
  attribute :userId, :id
  attribute :kind, :string
  attribute :active, :bool
  scope :by_chat do
    parameter :chatId, :id
    where chatId: :chatId
    subscribe "ChatActionSignal", id: ["chatId", "userId"], apply: { effect: :upsert, matches: { kind: ["TYPING", "RECORDING_AUDIO", "RECORDING_VIDEO", "UPLOADING_PHOTO", "UPLOADING_VIDEO"] }, delete_if: { not: "active" } }
  end
end

model ChatActivityNotice, storage: :memory, expires_in: 1.minute do
  attribute :chatId, :id
  attribute :userId, :id
  attribute :kind, :string
  attribute :active, :bool
  subscribe "ChatActionSignal", id: ["chatId", "userId"], apply: { effect: :upsert, matches: { kind: ["SCREENSHOT"] }, delete_if: { not: "active" } }
  scope :recent do
    order kind: :asc
  end
end
