model Notebook do
  changes "RecordEvents", from: "recordEvents.entries", area: "topic", kind: "action", id: "recordId"
  attribute :title, :string
  scope :node, node: :one do
    parameter :id, :id
    query "NotebookNode"
    variables id: :id
  end
  changed_by "NOTEBOOK", via: :node, removes_on: ["DELETED", "ACCESS_REVOKED"]
  changed_by "ENTRY", via: :node, id_of: { of: Entry, field: :notebookId }
end

model Entry do
  attribute :text, :string
  attribute :notebookId, :id
  scope :node, node: :one do
    parameter :id, :id
    query "EntryNode"
    variables id: :id
  end
  changed_by "ENTRY", via: :node, removes_on: ["DELETED", "ACCESS_REVOKED"]
  changed_by "REACTION", via: :node
end

model Article do
  attribute :text, :string
  scope :node, node: :one do
    parameter :id, :id
    query "ArticleNode"
    variables id: :id
  end
  changed_by "ARTICLE", via: :node, removes_on: ["DELETED", "ACCESS_REVOKED"]
  changed_by "REACTION", via: :node
end

model Totals do
  attribute :unread, :int
  scope :current do
    query "CurrentTotals"
  end
  changed_by "COUNTERS", via: :current
  changed_by "WALLET", via: :observed
end

model Folder do
  attribute :title, :string
  scope :node, node: :one do
    parameter :id, :id
    query "FolderNode"
    variables id: :id
  end
  changed_by "FOLDER", via: :node, removes_on: ["DELETED"]
  changed_by "FOLDER", via: :observed
end
