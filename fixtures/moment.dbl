uploads do
  create_blob :CreateBlob, root: "blobCreate"
  multipart initiate: :InitMultipart, presign: :PresignParts, complete: :CompleteMultipart, abort: :AbortMultipart, roots: { initiate: "initMultipart.multipartUpload" }
end

model Moment do
  attribute :uuid, :string
  attribute :userId, :id, null: true
  attribute :text, :string, null: true
  attribute :likedByMe, :bool, default: false
  attribute :media, :json, default: {}
  attribute :tone, :string, local: true
  attribute :createdAt, :date
  index :uuid
  search :text
  index :userId, :createdAt
  belongs_to :author, class_name: User, foreign_key: :userId, touch: true
  has_many :vibes, dependent: :destroy
  scope :transcode_status, node: :one do
    parameter :id, :id
    query "MomentTranscodeStatus"
    variables momentId: :id
  end
  scope :recent do
    order createdAt: :desc
  end
  scope :by_user do
    parameter :userId, :id
    where userId: :userId
    order createdAt: :desc
  end
  scope :feed do
    query "MomentsFeed"
    paginate size: 20, direction: :forward
    freshness expires_in: 5.minutes
    edge do
      attribute :impressionUuid, :string, null: true
      attribute :impressionScore, :int, null: true
    end
    subscribe "MomentEvents", apply: { effect: :upsert, delete_if: "destroyed" }
  end
  scope :vibe_feed do
    parameter :vibeId, :string
    query "MomentsFeed"
    paginate size: 20, direction: :forward
    edge do
      attribute :impressionUuid, :string, null: true
      attribute :score, :int, null: true, from: "impressionScore"
      attribute :rank, :enum, values: ["top", "normal"], as: FeedRank, null: true
    end
  end
  operation :create do
    mutation "CreateMoment"
  end
  operation :update do
    mutation "UpdateMoment"
  end
  operation :upload_clip, upload: true do
    mutation "CreateMoment"
    optimistic false
    returns
    response from: "createMoment"
  end
  operation :destroy do
    mutation "DeleteMoment"
  end
  operation :like do
    mutation "LikeMoment"
    variables momentId: :id
    optimistic likedByMe: true
    refetch :feed
  end
  operation :share do
    mutation "ShareMoment"
    optimistic false
    variables momentId: :id
    returns
    response from: "shareMoment.moment"
  end
end
