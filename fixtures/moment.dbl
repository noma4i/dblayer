model Moment do
  schema do
    string :uuid,      index: true
    id     :userId,    null: true, index: true
    string :text,      null: true
    bool   :likedByMe, default: false
    object :media,     default: {}
    date   :createdAt, index: true

    index :userId, :createdAt
  end

  belongs_to :author, model: User, key: :userId, touch: true
  has_many   :vibes,  model: Vibe, key: :momentId, dependent: :destroy

  scope :recent,  order: { createdAt: :desc }
  scope :by_user, params: [:userId], where: { userId: :userId }, order: { createdAt: :desc }

  remote :feed do
    query MomentsFeed
    paginate 20
    fresh_for 5.minutes
    updates MomentEvents, deleted_by: :destroyed
  end

  create  with: CreateMoment, input: { text: :text, media: :media }
  update  with: UpdateMoment
  destroy with: DeleteMoment

  action :like do
    mutation   LikeMoment
    input      momentId: :id
    optimistic likedByMe: true
    refetch    :feed
  end

  action :share do
    mutation ShareMoment
    input    momentId: :id
    root     "shareMoment.moment"
    result   successMessage: :string, copies: :int
  end
end
