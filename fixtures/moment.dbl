model Moment do
  field :uuid, type: :string
  field :userId, type: :id, null: true
  field :text, type: :string, null: true
  field :likedByMe, type: :bool, default: false
  field :media, type: :object, default: {}
  field :tone, type: :string, optional: true, local: true
  field :createdAt, type: :date


  index :uuid
  search :text
  index :userId, :createdAt

  belongs_to :author, model: User, key: :userId, touch: true
  has_many   :vibes, dependent: :destroy

  node MomentTranscodeStatus, as: :transcode_status, variable: :momentId

  scope :recent do
    order createdAt: :desc
  end
  scope :by_user do
    where :userId
    order createdAt: :desc
  end

  scope :feed do
    fetch MomentsFeed
    paginate 20
    fresh_for 5.minutes
    updates MomentEvents, deleted_by: :destroyed
    edge :impressionUuid, type: :string, null: true
    edge :impressionScore, type: :int, null: true
  end

  scope :vibe_feed, text: [:vibeId] do
    fetch MomentsFeed
    paginate 20
    edge :impressionUuid, type: :string, null: true
  end

  operation :create do
    mutation CreateMoment
    input text: :text, media: :media
  end
  operation :update do
    mutation UpdateMoment
  end
  operation :destroy do
    mutation DeleteMoment
  end

  operation :like do
    mutation   LikeMoment
    input      momentId: :id
    optimistic likedByMe: true
    refetch    :feed
  end

  operation :share do
    mutation ShareMoment
    local_effect :none, reason: "the server answers with the share counters"
    input    momentId: :id
    root     "shareMoment.moment"
    result   successMessage: :string, copies: :int
  end
end
