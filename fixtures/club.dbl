model Club do
  attribute :name, :string
  operation :create do
    mutation "CreateClub"
    variables name: :name
  end
  operation :leave do
    mutation "LeaveClub"
    variables clubId: :id
    optimistic false
    removes_receiver
    response :ignore
  end
  operation :add_member do
    mutation "AddClubMember"
    optimistic false
    parameter :userIds, [:id]
    variables clubId: :id, userIds: :userIds
    joins_scope :club_members, model: Person, rows: :userIds, with: { clubId: :id }, order: :order, orders: ["JOINED", "OWNER_FIRST"]
    response from: "addClubMember"
  end
  operation :remove_member do
    mutation "RemoveClubMember"
    optimistic false
    parameter :userIds, [:id]
    variables clubId: :id, userIds: :userIds
    leaves_scope :club_members, model: Person, rows: :userIds, with: { clubId: :id }, order: :order, orders: ["JOINED", "OWNER_FIRST"]
    response from: "removeClubMember"
  end
end

model Person do
  attribute :name, :string
  scope :club_members do
    parameter :clubId, :string
    parameter :order, :string
    query "ClubMembers"
    response from: "node.members"
    paginate size: 30, direction: :forward
  end
end

model Letter do
  attribute :chatId, :id
  attribute :text, :string
  attribute :at, :int
  scope :thread do
    parameter :chatId, :id
    where chatId: :chatId
    order at: :asc
  end
  operation :create, durable: true do
    mutation "SendLetter"
    variables chatId: :chatId, text: :text, at: :at
  end
  operation :forward do
    mutation "ForwardLetter"
    optimistic false
    parameter :targetChatId, :id
    copies_receiver_to :targetChatId, field: :chatId
    variables letterId: :id, chatId: :targetChatId
    response from: "forwardLetter.letter"
  end
end
