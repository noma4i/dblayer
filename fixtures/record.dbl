model Record do
  attribute :containerId, :id
  attribute :authorId, :id
  attribute :regionId, :id, null: true
  attribute :text, :string
  attribute :createdAt, :date
  attribute :sequenceNumber, :int, null: true
  attribute :reactions, [RecordReactionNode], default: [] do
    attribute :body, :string, null: true
    attribute :userId, :id, null: true, from: "user.id"
    attribute :user, RecordReactionUser, null: true, ref: User, id: :userId do
      attribute :id, :id, null: true
      attribute :name, :string, null: true
    end
  end
  attribute :attachment, RecordAttachment, null: true do
    on RewardAttachment do
      attribute :id, :id
      attribute :tier, :string, from: "rewardTier"
      attribute :status, :string, null: true
      attribute :tags, [:string], default: []
    end
    on MomentAttachment do
      attribute :momentId, :id
      attribute :caption, :string, null: true
    end
    on ProfileAttachment do
      attribute :user, AttachmentUser, null: true do
        attribute :id, :id
        attribute :name, :string, null: true
      end
    end
    on ReactionAttachment do
      attribute :body, :string
    end
  end
  attribute :media, RecordMedia, null: true, merge: { fileUrl: :non_empty } do
    attribute :kind, :string, null: true
    attribute :transcoded, :bool, null: true
    attribute :fileUrl, :string, null: true
  end
  belongs_to :container, sets: { lastRecordId: :id, lastRecordAt: :createdAt, lastSequenceNumber: :sequenceNumber }, newer: [:sequenceNumber, :createdAt]
  scope :by_container do
    parameter :containerId, :id
    where containerId: :containerId
    order createdAt: :asc
  end
  scope :thread, insert_on: :server, stable_order: true do
    parameter :containerId, :id
    where containerId: :containerId
    order sequenceNumber: :asc_nulls_last, createdAt: :asc
    query "ContainerThread"
    response from: "container.records"
    paginate size: 30, direction: :forward
  end
  operation :create do
    mutation "CreateRecord"
    parameter :signedId, :string, null: true
    parameter :attachedUserId, :id, null: true
    local :authorId, from: { of: CurrentUser, field: :id }
    local :regionId, from: { of: CurrentRegion, field: :id }
  end
  scope :node, node: :one do
    parameter :id, :id
    query "RecordNode"
    variables id: :id
  end
  scope :transcode_status, node: :one do
    parameter :id, :id
    query "RecordTranscodeStatus"
    variables id: :id
  end
  operation :react do
    mutation "RecordReact"
    parameter :reactionBody, :string
    parameter :userId, :id
    optimistic reactions: { by: :userId, element: { userId: :userId, body: :reactionBody } }
  end
  scope :container_media do
    parameter :containerId, :id
    where containerId: :containerId
    query "ContainerMedia"
    response from: "node.records"
    paginate size: 30, direction: :forward
  end
  scope :history do
    query "ContainerRecords"
    paginate size: 30, direction: :backward
    freshness expires_in: 1.minute, empty_in: 10.seconds
  end
  scope :recent_media, insert_on: :server, refresh_on_foreground: true do
    parameter :containerId, :id
    where containerId: :containerId
    query "RecentMedia"
    response from: "recentMedia"
    paginate size: 20, direction: :forward, max_pages: 5
  end
  operation :pin do
    mutation "RecordPin"
    optimistic false
    on_failure :keep
    upsert Container, from: "recordPin.container"
    response from: "recordPin.record"
  end
  changed_by "RECORD", via: :observed
end

model CurrentUser do
  attribute :name, :string
  scope :current do
    query "CurrentUserQuery"
  end
  operation :update_photo, upload: true do
    optimistic false
    mutation "UserPhotoUpdate"
    parameter :keepOld, :bool, null: true
    parameter :skipAssign, :bool, null: true
    returns
    response from: "userPhotoUpdate.viewer.user"
  end
end

model CurrentRegion do
  attribute :name, :string
  scope :current do
    query "CurrentRegionQuery"
  end
end
