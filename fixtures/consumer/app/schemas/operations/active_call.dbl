operation :active_call do
  query "activeCall"
  returns do
    attribute :activeCall, ActiveCallResultActiveCall do
      attribute :id, :id
      attribute :status, :string
      attribute :mediaKind, :string
      attribute :origin, :string
      attribute :direction, :string
      attribute :createdAt, :string
      attribute :answeredAt, :string
      attribute :endedAt, :string
      attribute :peer, ActiveCallResultActiveCallPeer do
        attribute :id, :id
      end
    end
  end
end
