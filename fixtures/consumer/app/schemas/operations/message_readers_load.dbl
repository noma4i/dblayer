operation :message_readers_load do
  query "messageReaders"
  parameter :messageId, :id
  parameter :first, :int, null: true
  parameter :after, :string, null: true
  returns do
    attribute :readers, MessageReadersResultReaders do
      attribute :edges, [MessageReadersResultReadersEdges] do
        attribute :cursor, :string
        attribute :node, MessageReadersResultReadersEdgesNode do
          attribute :readAt, :string
          attribute :user, MessageReadersResultReadersEdgesNodeUser do
            attribute :id, :id
            attribute :fullName, :string
            attribute :avatarUrl, :string
          end
        end
      end
      attribute :pageInfo, MessageReadersResultReadersPageInfo do
        attribute :hasNextPage, :bool
        attribute :endCursor, :string
      end
    end
  end
end
