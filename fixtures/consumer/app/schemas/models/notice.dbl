model Notice, storage: :memory, expires_in: 1.minute do
  attribute :kind, :enum, values: ["ACCOUNT_LOCKED", "ANNOUNCEMENT"], as: NoticeKind
  attribute :title, :string, null: true
  attribute :body, :string
  attribute :occurredAt, :date
  scope :recent do
    order occurredAt: :desc
    subscribe "userBlocked"
  end
end
