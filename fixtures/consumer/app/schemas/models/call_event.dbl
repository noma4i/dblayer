model CallEvent, storage: :memory, expires_in: 30.seconds do
  attribute :kind, :enum, values: ["ACCEPTED", "DECLINED", "ENDED", "INCOMING", "SIGNAL"], as: CallEventKind
  attribute :occurredAt, :date
  attribute :callId, :id, from: "call.id"
  attribute :callStatus, :enum, values: ["ACCEPTED", "DECLINED", "ENDED", "FAILED", "MISSED", "RINGING"], as: CallEventStatus, from: "call.status"
  attribute :callOrigin, :enum, values: ["ADMIN_TEST", "APP"], as: CallEventOrigin, from: "call.origin"
  attribute :callDirection, :enum, values: ["INCOMING", "OUTGOING"], as: CallEventDirection, from: "call.direction"
  attribute :peerId, :id, null: true, from: "call.peer.id"
  belongs_to :peer, class_name: User, foreign_key: :peerId, from: "call.peer"
  attribute :createdAt, :date, from: "call.createdAt"
  attribute :answeredAt, :date, null: true, from: "call.answeredAt"
  attribute :endedAt, :date, null: true, from: "call.endedAt"
  attribute :signalKind, :enum, values: ["ANSWER", "CANDIDATE", "OFFER"], as: CallEventSignalKind, null: true, from: "signal.kind"
  attribute :sdp, :string, null: true, from: "signal.sdp"
  attribute :candidate, :string, null: true, from: "signal.candidate"
  attribute :sdpMid, :string, null: true, from: "signal.sdpMid"
  attribute :sdpMLineIndex, :int, null: true, from: "signal.sdpMLineIndex"
  scope :recent do
    order occurredAt: :desc
    subscribe "callEvents"
  end
end
