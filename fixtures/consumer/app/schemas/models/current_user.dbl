model CurrentUser do
  attribute :id, :id, from: "user.id"
  attribute :fullName, :string, from: "user.fullName"
  attribute :username, :string, from: "user.username"
  attribute :online, :bool, from: "user.online"
  attribute :shareUrl, :string, from: "user.shareUrl"
  attribute :createdAt, :date, from: "user.createdAt"
  attribute :updatedAt, :date, from: "profile.updatedAt"
  attribute :registrationCompleted, :bool, from: "profile.registrationCompleted"
  attribute :kind, :enum, values: ["BOT", "DEVELOPER", "MANAGED", "REGULAR"], as: UserKind, from: "profile.kind"
  attribute :status, :enum, values: ["DEACTIVATED", "DISABLED", "ENABLED", "LIMITED"], as: AccountStatus, from: "profile.status", null: true
  attribute :filterGender, :enum, values: ["EVERYONE", "FEMALE", "INDETERMINATE", "MALE"], as: GenderFilter, from: "settings.filters.gender", null: true
  attribute :filterMinAge, :int, from: "settings.filters.minAge", null: true
  attribute :filterMaxAge, :int, from: "settings.filters.maxAge", null: true
  attribute :hasCompass, :bool, from: "profile.hasCompass"
  attribute :hasMoments, :bool, from: "profile.hasMoments"
  attribute :hasPhoto, :bool, from: "profile.hasPhoto"
  attribute :hasGoodPhoto, :bool, from: "profile.hasGoodPhoto"
  attribute :hasInitialMoment, :bool, from: "profile.hasInitialMoment"
  attribute :stickyLocation, :bool, from: "profile.stickyLocation"
  attribute :preferenceNotifyConnection, :bool, from: "settings.notifyConnections", null: true
  attribute :preferenceNotifyMessage, :bool, from: "settings.notifyMessages"
  attribute :preferenceVibration, :bool, from: "settings.vibration", null: true
  attribute :travelMode, :bool, null: true, from: "settings.travelMode"
  attribute :email, :string, null: true, from: "profile.email"
  attribute :dob, :string, null: true, from: "profile.dateOfBirth"
  attribute :avatarUrl, :string, null: true, from: "user.avatarUrl"
  attribute :fullAvatarUrl, :string, null: true, from: "user.fullAvatarUrl"
  attribute :countryCode, :string, null: true, from: "profile.country.code"
  attribute :age, :int, null: true, from: "user.age"
  attribute :gender, :enum, values: ["FEMALE", "INDETERMINATE", "MALE"], as: Gender, null: true, from: "profile.gender"
  attribute :registrationStep, :enum, values: ["BIRTHDAY", "DONE", "NAME", "PHOTO", "PHOTO_APPROVED", "PURPOSE"], as: RegistrationStep, null: true, from: "profile.registrationStep"
  attribute :feedVariant, :enum, values: ["EXPLORING", "FIND_LOVE", "MAKE_FRIENDS", "MEET_LOCALS", "SPORTS_GAMES"], as: FeedVariant, null: true, from: "profile.feedVariant"
  attribute :description, :string, null: true, from: "user.description"
  attribute :story, :string, null: true, from: "user.story"
  attribute :locationCity, :string, null: true, from: "profile.location.city"
  attribute :locationName, :string, null: true, from: "profile.location.name"
  attribute :locationLat, :num, null: true, from: "profile.location.lat"
  attribute :locationLng, :num, null: true, from: "profile.location.lng"
  attribute :filterDistance, :int, null: true, from: "settings.filters.distanceKilometers"
  attribute :premiumGrant, PremiumGrant, null: true, from: "wallet.premium" do
    attribute :id, :id
    attribute :createdAt, :date
    attribute :updatedAt, :date
    attribute :expiresAt, :string, null: true
    attribute :localizedPrice, :string, null: true
    attribute :productId, :string, null: true, from: "product.productId"
  end
  attribute :mainPhoto, CurrentUserPhoto, null: true, from: "profile.mainPhoto" do
    attribute :id, :id
    attribute :kind, :enum, values: ["MAIN_PICTURE", "SECONDARY_PICTURE"], as: UserPhotoKind, null: true
    attribute :status, :enum, values: ["BAD", "GOOD"], as: UserPhotoStatus, null: true
    attribute :reason, :string, null: true
    attribute :createdAt, :string, null: true
    attribute :updatedAt, :string, null: true
    attribute :media, MomentMedia, null: true
  end
  attribute :balance, :int, default: 0, from: "wallet.balance"
  attribute :receivedGifts, [ReceivedGift], default: [], from: "profile.receivedGifts" do
    attribute :count, :int
    attribute :gift, ReceivedGiftGift do
      attribute :id, :id
      attribute :name, :string
      attribute :imageUrl, :string, null: true
      attribute :animationUrl, :string, null: true
      attribute :description, :string, null: true
      attribute :cost, :int, null: true
      attribute :price, :int, null: true
      attribute :status, :enum, values: ["ACTIVE", "INACTIVE"], as: GiftStatus, null: true
      attribute :createdAt, :string, null: true
      attribute :updatedAt, :string, null: true
    end
    attribute :items, [ReceivedGiftItem] do
      attribute :id, :id
      attribute :createdAt, :string
      attribute :sender, ReceivedGiftSender, null: true do
        attribute :id, :id
        attribute :fullName, :string
        attribute :avatarUrl, :string, null: true
        attribute :username, :string, null: true
        attribute :updatedAt, :string, null: true
        attribute :createdAt, :string, null: true
        attribute :online, :bool
        attribute :lastSeenAt, :string, null: true
        attribute :connectionChatId, :id, null: true, from: "relationship.chatId"
        attribute :connectionStatus, :enum, values: ["CONNECTED", "NEVER_MET", "RECEIVED_PENDING", "SENT_PENDING"], as: ConnectionStatus, null: true, from: "relationship.status"
        attribute :lastInteraction, :enum, values: ["GIFT", "MOMENT_REACTION", "NO_INTERACTION", "VIDEO_INTRO"], as: LastInteraction, null: true, from: "relationship.lastInteraction"
      end
    end
  end
  attribute :unreadChatsCount, :int, default: 0, from: "counters.unreadChats"
  attribute :primaryChatsCount, :int, from: "counters.primaryChats"
  attribute :unreadCompassCount, :int, default: 0, from: "counters.unreadCompass"
  attribute :unreadSecondaryChatsCount, :int, default: 0, from: "counters.unreadSecondaryChats"
  attribute :secondaryChatsCount, :int, default: 0, from: "counters.secondaryChats"
  attribute :premiumSecondaryChatsCount, :int, default: 0, from: "counters.premiumSecondaryChats"
  operation :update do
    mutation "UserUpdate"
    wrap "input"
    variables name: :fullName, description: :description, dateOfBirth: :dob, gender: :gender, feedVariant: :feedVariant, story: :story, handle: :username, countryCode: :countryCode, filterDistanceKilometers: :filterDistance, filterGender: :filterGender, filterMinAge: :filterMinAge, filterMaxAge: :filterMaxAge, preferenceNotifyConnection: :preferenceNotifyConnection, preferenceNotifyMessage: :preferenceNotifyMessage, preferenceVibration: :preferenceVibration
    response :ignore
    refetch :profile
  end
  operation :update_location do
    mutation "UserLocationUpdate"
    parameter :latitude, :num
    parameter :longitude, :num
    variables latitude: :latitude, longitude: :longitude
    optimistic locationLat: :latitude, locationLng: :longitude
    wrap "input"
    response :ignore
    refetch :profile
  end
  operation :registration_complete do
    optimistic false
    mutation "UserRegistrationComplete"
    refetch :profile
    returns do
      attribute :viewer, UserRegistrationCompleteResultViewer do
        attribute :profile, UserRegistrationCompleteResultViewerProfile do
          attribute :registrationCompleted, :bool
        end
      end
    end
  end
  operation :update_photo, upload: true do
    optimistic false
    mutation "UserPhotoUpdate"
    parameter :createInitialMoment, :bool, null: true
    parameter :skipAssign, :bool, null: true
    variables createInitialMoment: :createInitialMoment, skipAssign: :skipAssign
    wrap "input"
    upsert Moment, from: "userPhotoUpdate.moment"
    returns do
      attribute :moment, AvatarUploadMoment do
        attribute :id, :id
      end
      attribute :userPhoto, AvatarUploadPhoto do
        attribute :reason, :string
        attribute :status, UserPhotoStatus
        attribute :media, AvatarUploadMedia do
          attribute :thumbUrl, :string
        end
      end
    end
    response from: "userPhotoUpdate.viewer"
  end
  scope :profile do
    query "myProfile"
    freshness expires_in: 10.minutes
  end
  changed_by "COUNTERS", via: :profile
  changed_by "GIFT", via: :profile
end
