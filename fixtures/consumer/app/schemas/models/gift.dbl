model Gift do
  attribute :name, :string
  attribute :description, :string, null: true
  attribute :imageUrl, :string, null: true
  attribute :animationUrl, :string, null: true
  attribute :price, :int
  attribute :cost, :int
  attribute :status, :enum, values: ["ACTIVE", "INACTIVE"], as: GiftStatus
  attribute :createdAt, :date
  attribute :updatedAt, :date
  scope :catalog do
    query "gifts"
    paginate size: 50, direction: :forward
    freshness expires_in: 3.days
    preload
  end
end
