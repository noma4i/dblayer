model InteractionNotice, storage: :memory, expires_in: 1.minute do
  attribute :action, :enum, values: ["GIFT_UNWRAPPED", "VIDEO_NOTE_VIEWED"], as: InteractionAction
  attribute :actorUserId, :id
  attribute :messageId, :id
  attribute :chatId, :id
  attribute :occurredAt, :date
  scope :recent do
    order occurredAt: :desc
    subscribe "interactiveAction"
  end
end
