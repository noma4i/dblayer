model MomentCompass do
  attribute :hasUnread, :bool, default: false
  attribute :similarIds, [:id], default: []
  references :similar, class_name: Moment, foreign_key: :similarIds, from: "similarMoments.moment"
  scope :for_moment do
    parameter :id, :id
    where id: :id
    query "compassForMoment"
    variables momentId: :id
    freshness expires_in: 5.minutes
  end
end
