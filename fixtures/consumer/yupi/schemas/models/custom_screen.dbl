model CustomScreen do
  attribute :slug, :string
  attribute :version, :int
  attribute :status, :enum, values: ["ARCHIVED", "DRAFT", "PUBLISHED"], as: CustomScreenStatus, null: true
  attribute :requires, ScreenRequires, null: true do
    attribute :ios, :int, null: true
    attribute :android, :int, null: true
  end
  attribute :spec, ScreenSpec, null: true, from: "spec" do
    attribute :root, :string
    attribute :state, [ScreenStateEntry], default: [] do
      attribute :path, :string
      attribute :value, :json, parse: :json
    end
    attribute :elements, [ScreenElement], default: [] do
      attribute :id, :string
      attribute :type, :string
      attribute :slot, :string, null: true
      attribute :children, [:string], default: []
      attribute :props, :json, parse: :json, null: true
      attribute :visible, :json, parse: :json, null: true
      attribute :press, :json, parse: :json, null: true
      attribute :change, :json, parse: :json, null: true
    end
  end
  scope :by_slug do
    parameter :id, :id
    where id: :id
    query "customScreen"
    variables slug: :id
    freshness expires_in: 1.minute
    subscribe "CustomScreenDocumentUpdated", from: "customScreenUpdated", id: "slug"
  end
  scope :by_trigger do
    parameter :id, :id
    where id: :id
    query "customScreenByTrigger"
    variables key: :id
    freshness expires_in: 1.minute
  end
  changed_by "CUSTOM_SCREEN", via: :observed
end
