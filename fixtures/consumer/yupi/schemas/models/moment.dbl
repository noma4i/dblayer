scalar :Cursor, as: :string

scalar :ISO8601Date, as: :date

scalar :ISO8601DateTime, as: :date

scalar :Int64, as: :long

model Moment do
  attribute :uuid, :string
  attribute :userId, :id, null: true, from: "user.id"
  attribute :userFullName, :string, null: true, from: "user.fullName"
  attribute :userUsername, :string, null: true, from: "user.username"
  attribute :kind, :enum, values: ["BASIC", "INITIAL"], as: MomentKind, default: :BASIC
  attribute :status, :enum, values: ["DRAFTED", "PUBLISHED", "SCHEDULED"], as: MomentStatus, default: :DRAFTED
  attribute :contentKind, :enum, values: ["CENSORED", "SAFE", "SENSITIVE"], as: MomentContentKind, default: :SAFE
  attribute :media, MomentMedia, null: true, merge: { fileUrl: :non_empty, thumbUrl: :non_empty, coverUrl: :non_empty, gifUrl: :non_empty, width: :positive, height: :positive, transcodeStatus: [[:PENDING, :SUBMITTED, :PROGRESSING], [:COMPLETED, :FAILED]], transcodeProgress: :monotonic } do
    attribute :kind, :enum, values: ["AUDIO", "IMAGE", "VIDEO"], as: MediaKind, null: true
    attribute :fileUrl, :string, null: true
    attribute :thumbUrl, :string, null: true
    attribute :coverUrl, :string, null: true
    attribute :blurHash, :string, null: true
    attribute :gifUrl, :string, null: true
    attribute :transcodeStatus, :enum, values: ["COMPLETED", "FAILED", "PENDING", "PROGRESSING", "SUBMITTED"], as: TranscodeStatus, null: true
    attribute :width, :num, null: true
    attribute :height, :num, null: true
    attribute :transcoded, :bool, null: true
    attribute :duration, :num, null: true
    attribute :transcodeProgress, :num, null: true
    attribute :transcodeError, :string, null: true
    attribute :blobId, :id, null: true
    attribute :createdAt, :string, null: true
    attribute :updatedAt, :string, null: true
  end
  attribute :compassTitle, :string, default: ""
  attribute :compassUpdatedAt, :date, null: true
  attribute :reacted, :bool, default: false
  attribute :shadowBanned, :bool, default: false
  attribute :shadowBannedAt, :date, null: true
  attribute :shadowBannedByUsername, :string, null: true, from: "shadowBannedBy.username"
  attribute :shadowBannedByFullName, :string, null: true, from: "shadowBannedBy.fullName"
  attribute :shadowBannedByKind, :enum, values: ["ADMIN", "DEVELOPER"], as: ShadowBanActorKind, null: true, from: "shadowBannedBy.kind"
  attribute :shareUrl, :string, default: ""
  attribute :localPreviewUrl, :string, optional: true, local: true
  attribute :visitsCount, :int, null: true
  attribute :visitorIds, [:id], optional: true
  attribute :similarIds, [:id], optional: true
  attribute :unreadCount, :int, null: true
  attribute :similarMomentsCount, :int, default: 0
  attribute :unreadSimilarMomentsCount, :int, default: 0
  attribute :widgets, [MomentWidgetData], default: [] do
    attribute :id, :id, null: true
    attribute :kind, :enum, values: ["CURRENTLY", "EMOJI", "GIF", "HASHTAG", "LABEL", "LOCATION", "TEMPERATURE", "TIME"], as: MomentWidgetKind
    attribute :settings, MomentWidgetDataSettings, null: true do
      attribute :offset, MomentWidgetOffset, null: true do
        attribute :horizontal, :num, from: "x"
        attribute :vertical, :num, from: "y"
      end
      attribute :scale, :num, null: true
      attribute :rotate, :num, null: true
      attribute :itemProps, MomentWidgetItemProps, null: true do
        on MomentLabelProps do
          attribute :title, :string
          attribute :color, :string
          attribute :backgroundColor, :string, null: true
          attribute :fontFamily, :string, null: true
          attribute :textAlign, :enum, values: ["CENTER", "LEFT", "RIGHT"], as: MomentWidgetTextAlign
        end
        on MomentEmojiProps do
          attribute :emoji, :string, null: true
        end
        on MomentGifProps do
          attribute :gifId, :string, null: true
          attribute :url, :string, null: true
        end
        on MomentLocationProps do
          attribute :location, MomentPlace, null: true do
            attribute :id, :string, null: true
            attribute :name, :string, null: true
            attribute :coord, :string, null: true
          end
          attribute :colorIndex, :int
        end
        on MomentHashtagProps do
          attribute :title, :string
          attribute :colorIndex, :int
        end
        on MomentTemperatureProps do
          attribute :value, :string, null: true
        end
      end
    end
    attribute :createdAt, :string, null: true
    attribute :updatedAt, :string, null: true
  end
  attribute :metrics, MomentMetrics, null: true do
    attribute :qualityScore, :int, null: true
    attribute :aiScore, :int, null: true
    attribute :contentRating, :enum, values: ["EXPLICIT", "EXTREME", "MODERATE", "NOT_RATING", "SAFE", "SUGGESTIVE"], as: ContentRating, null: true
    attribute :analyzeStatus, :enum, values: ["COMPLETED", "FAILED", "PENDING"], as: AnalyzeStatus, null: true
    attribute :analyzedAt, :string, null: true
    attribute :keywords, [:string], null: true
    attribute :objects, [:string], null: true
    attribute :scenes, [:string], null: true
    attribute :moods, [:string], null: true
    attribute :genders, [:string], null: true
    attribute :compatibilityIndicators, [:string], null: true
    attribute :styleLifestyles, [:string], null: true
    attribute :colors, [MomentMetricsColor], null: true do
      attribute :name, :string
      attribute :weight, :num, null: true
    end
    attribute :description, :string, null: true
    attribute :qualityScoreReason, :string, null: true
    attribute :aiScoreReason, :string, null: true
    attribute :contentRatingReason, :string, null: true
  end
  attribute :createdAt, :date
  attribute :updatedAt, :date
  belongs_to :user
  scope :node, node: :one do
    parameter :id, :id
    query "MomentNode"
    variables momentId: :id
    freshness expires_in: 5.minutes
  end
  changed_by "MOMENT", via: :node, removes_on: ["DELETED", "ACCESS_REVOKED"]
  changed_by "REACTION", via: :node
  scope :transcode_status, node: :one do
    parameter :id, :id
    query "MomentTranscodeStatus"
    variables momentId: :id
  end
  references :visitors, class_name: User, foreign_key: :visitorIds, from: "visitors.edges.node"
  references :similar, class_name: Moment, foreign_key: :similarIds, from: "similarMoments.moment"
  operation :destroy do
    mutation "MomentDelete"
    wrap "input"
    variables momentId: :id
  end
  operation :collect_view do
    mutation "MomentViewTrack"
    variables momentId: :id
    optimistic false
    wrap "input"
    response :ignore
  end
  operation :create_file, upload: true do
    mutation "MomentCreateFile"
    parameter :widgets, [MomentWidgetInput], null: true
    optimistic false
    response from: "momentCreate.moment"
  end
  operation :react do
    mutation "MomentReact"
    parameter :reactionBody, :string
    parameter :reacted, :bool
    parameter :visitsCount, :int
    parameter :visitorIds, [:id]
    variables momentId: :id, reactionBody: :reactionBody
    optimistic reacted: :reacted, visitsCount: :visitsCount, visitorIds: :visitorIds
    wrap "input"
    response :ignore
  end
  operation :set_quality_score do
    optimistic false
    mutation "DeveloperMomentUpdate"
    parameter :qualityScore, :int
    variables momentId: :id, qualityScore: :qualityScore
    wrap "input"
    response from: "developerMomentUpdate.moment"
  end
  operation :set_ai_score do
    optimistic false
    mutation "DeveloperMomentUpdate"
    parameter :aiScore, :int
    variables momentId: :id, aiScore: :aiScore
    wrap "input"
    response from: "developerMomentUpdate.moment"
  end
  operation :set_content_kind do
    optimistic false
    mutation "DeveloperMomentUpdate"
    parameter :contentKind, MomentContentKind
    variables momentId: :id, contentKind: :contentKind
    wrap "input"
    response from: "developerMomentUpdate.moment"
  end
  operation :reanalyze do
    optimistic false
    mutation "DeveloperMomentReanalyze"
    variables momentId: :id
    wrap "input"
    response from: "developerMomentReanalyze.moment"
  end
  operation :shadow_ban do
    optimistic false
    mutation "MomentShadowBan"
    variables momentId: :id
    wrap "input"
    response from: "momentShadowBan.moment"
    refetch :in_shadow_ban
  end
  operation :shadow_ban_remove do
    optimistic false
    mutation "MomentShadowBanRemove"
    variables momentId: :id
    wrap "input"
    response from: "momentShadowBanRemove.moment"
    refetch :in_shadow_ban
  end
  operation :read_compass do
    mutation "CompassRead"
    variables momentId: :id
    optimistic unreadCount: 0, unreadSimilarMomentsCount: 0
    wrap "input"
    response from: "compassRead.moment"
    refetch :profile, model: CurrentUser
  end
  scope :feed do
    query "feed"
    paginate size: 20, direction: :forward, max_pages: 30
    freshness expires_in: 24.hours, empty_in: 30.seconds
    edge do
      attribute :impressionUuid, :string, null: true
      attribute :impressionScore, :int, null: true
    end
    preload
  end
  scope :vibe_feed do
    parameter :vibeId, :string
    query "feed"
    paginate size: 20, direction: :forward, max_pages: 30
    freshness expires_in: 24.hours, empty_in: 30.seconds
    edge do
      attribute :impressionUuid, :string, null: true
      attribute :impressionScore, :int, null: true
    end
  end
  scope :in_shadow_ban do
    query "shadowBannedMoments"
    paginate size: 20, direction: :forward, max_pages: 20
    freshness expires_in: 1.minute
  end
  scope :by_user do
    parameter :userId, :id
    where userId: :userId
    order createdAt: :desc
    query "userMoments"
    response from: "user.moments"
    paginate size: 20, direction: :forward, max_pages: 20
    freshness expires_in: 10.minutes
  end
  scope :owned, insert_on: [:create] do
    order createdAt: :desc
    query "myMoments"
    response from: "viewer.moments"
    paginate size: 20, direction: :forward, max_pages: 20
    freshness expires_in: 24.hours
    preload
  end
  scope :by_uuid do
    parameter :uuid, :string
    where uuid: :uuid
    query "momentByUuid"
    freshness expires_in: 10.minutes, empty_in: 30.seconds
  end
  scope :compass do
    order unreadSimilarMomentsCount: :desc, createdAt: :desc
    query "meCompass"
    response from: "viewer.compassMoments"
    paginate size: 20, direction: :forward, max_pages: 20
    freshness expires_in: 24.hours
    preload
  end
end
