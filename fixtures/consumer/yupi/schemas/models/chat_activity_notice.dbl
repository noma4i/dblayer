model ChatActivityNotice, storage: :memory, expires_in: 1.minute do
  attribute :chatId, :id
  attribute :userId, :id
  attribute :kind, :enum, values: ["RECORDING_AUDIO", "RECORDING_VIDEO", "SCREENSHOT", "TYPING", "UPLOADING_PHOTO", "UPLOADING_VIDEO"], as: ChatActivityKind
  attribute :active, :bool
  attribute :createdAt, :date
  attribute :expiresAt, :date
  scope :recent do
    order expiresAt: :desc
    subscribe "chatAction"
  end
end
