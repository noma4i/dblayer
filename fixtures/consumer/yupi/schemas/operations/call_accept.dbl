operation :call_accept do
  mutation "CallAccept"
  parameter :input, CallAcceptInput
  returns do
    attribute :call, CallAcceptResultCall do
      attribute :id, :id
      attribute :status, :string
      attribute :answeredAt, :string
      attribute :endedAt, :string
    end
    attribute :iceServers, [CallAcceptResultIceServers] do
      attribute :urls, [:string]
      attribute :username, :string
      attribute :credential, :string
    end
  end
end
