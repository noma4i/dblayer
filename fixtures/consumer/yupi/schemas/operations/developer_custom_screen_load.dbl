operation :developer_custom_screen_load do
  query "developerCustomScreen"
  parameter :slug, :string
  parameter :kind, CustomScreenSourceKind
  parameter :number, :int, null: true
  returns do
    attribute :slug, :string
    attribute :spec, DeveloperCustomScreenLoadResultSpec do
      attribute :root, :string
      attribute :state, [DeveloperCustomScreenLoadResultSpecState] do
        attribute :path, :string
        attribute :value, :string
      end
      attribute :elements, [DeveloperCustomScreenLoadResultSpecElements] do
        attribute :id, :string
        attribute :type, :string
        attribute :slot, :string
        attribute :children, [:string]
        attribute :props, :string
        attribute :visible, :string
        attribute :press, :string
        attribute :change, :string
      end
    end
  end
end
