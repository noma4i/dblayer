operation :call_start do
  mutation "CallStart"
  parameter :input, CallStartInput
  returns do
    attribute :call, CallStartResultCall do
      attribute :id, :id
      attribute :status, :string
      attribute :mediaKind, :string
      attribute :origin, :string
      attribute :direction, :string
      attribute :createdAt, :string
      attribute :answeredAt, :string
      attribute :endedAt, :string
      attribute :peer, CallStartResultCallPeer do
        attribute :id, :id
      end
    end
    attribute :iceServers, [CallStartResultIceServers] do
      attribute :urls, [:string]
      attribute :username, :string
      attribute :credential, :string
    end
  end
end
