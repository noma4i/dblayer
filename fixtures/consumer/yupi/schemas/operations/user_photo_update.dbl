operation :user_photo_update do
  mutation "UserPhotoUpdate"
  parameter :input, UserPhotoUpdateInput
  returns do
    attribute :moment, UserPhotoUpdateResultMoment do
      attribute :id, :id
    end
    attribute :userPhoto, UserPhotoUpdateResultUserPhoto do
      attribute :reason, :string
      attribute :status, UserPhotoStatus
      attribute :media, UserPhotoUpdateResultUserPhotoMedia do
        attribute :thumbUrl, :string
      end
    end
  end
end
