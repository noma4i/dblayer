operation :unseen_connections do
  query "unseenConnections"
  response shape: :list
  returns do
    attribute :acceptedAt, :string
    attribute :user, UnseenConnectionsResultUser do
      attribute :id, :id
      attribute :fullName, :string
      attribute :avatarUrl, :string
    end
    attribute :chat, UnseenConnectionsResultChat do
      attribute :id, :id
      attribute :connectedAt, :string
    end
  end
end
