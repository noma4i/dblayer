operation :chat_media_state do
  query "chatMediaState"
  parameter :chatId, :id
  parameter :upToSequence, :int, null: true
  returns do
    attribute :mediaLibrary, ChatMediaStateResultMediaLibrary do
      attribute :visualCount, :int
      attribute :audioCount, :int
      attribute :giftCount, :int
      attribute :latestSequence, :int
    end
  end
end
