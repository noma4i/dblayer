model Inbox do
  attribute :title, :string
  attribute :stance, :string, null: true
  operation :move do
    mutation "InboxMove"
    parameter :list, ContainerShelfKind
    optimistic stance: { from: :list, map: { PRIMARY: "main", SECONDARY: "other" } }
    response from: "inboxMove"
  end
  scope :shelf do
    parameter :list, ContainerShelfKind
    query "inbox"
    response from: "inbox"
    paginate size: 25, direction: :forward
  end
end
