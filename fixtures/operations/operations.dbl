scalar :DateTime, as: :date

operation :when do
  query "KeywordCall"
  parameter :class, :string
end

operation :qr_code_create do
  mutation "QrCodeCreate"
  parameter :kind, :string
  parameter :size, :int, null: true
end

operation :sign_out do
  mutation "SignOut"
end

operation :sticker_send do
  mutation "StickerSend"
  parameter :input, StickerInput
end

operation :pricing_load do
  query "Pricing"
end

operation :moment_create do
  mutation "MomentCreate"
  parameter :input, MomentInput
end

operation :giphy_load do
  query "Giphy"
  response shape: :list
  parameter :type, :string
  parameter :limit, :int, null: true
end

operation :widgets_send do
  mutation "WidgetsSend"
  parameter :widgets, [StickerWidgetInput], null: true
end

operation :container_media_load do
  query "containerMedia"
  parameter :containerId, :id
  parameter :upToSequence, :int, null: true
end

operation :peer_load do
  query "PeerLoad"
end

operation :chat_library do
  query "ChatLibrary"
  parameter :id, :id
end
