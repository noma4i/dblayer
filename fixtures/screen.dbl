model CustomScreen do
  attribute :slug, :string
  attribute :version, :int
  attribute :requires, ScreenRequires do
    attribute :ios, :int, null: true
    attribute :android, :int, null: true
  end
  attribute :spec, ScreenSpec, null: true do
    attribute :root, :id
    attribute :state, [ScreenStateEntry] do
      attribute :path, :string
      attribute :value, :json, parse: :json
    end
    attribute :elements, [ScreenElement] do
      attribute :id, :id
      attribute :type, :string
      attribute :slot, :string, null: true
      attribute :children, [:id]
      attribute :props, :json, parse: :json, null: true
      attribute :visible, :json, parse: :json, null: true
      attribute :press, :json, parse: :json, null: true
      attribute :change, :json, parse: :json, null: true
      attribute :padding, :string, null: true
      attribute :margin, :string, null: true
      attribute :background, :string, null: true
      attribute :radius, :string, null: true
      attribute :expand, :bool, null: true
      attribute :align, :string, null: true
      attribute :accessibilityLabel, :string, null: true
    end
  end
  scope :node, node: :one do
    parameter :id, :id
    query "ScreenNode"
    variables id: :id
  end
end
