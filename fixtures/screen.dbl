model CustomScreen do
  field :slug, type: :string
  field :version, type: :int
  field :requires, type: ScreenRequires do
    field :ios, type: :int, null: true
    field :android, type: :int, null: true
  end
  field :spec, type: ScreenSpec, null: true do
    field :root, type: :id
    field :state, type: [ScreenStateEntry] do
      field :path, type: :string
      field :value, type: :raw, parse: :json
    end
    field :elements, type: [ScreenElement] do
      field :id, type: :id
      field :type, type: :string
      field :slot, type: :string, null: true
      field :children, type: [:id]
      field :props, type: :raw, parse: :json, null: true
      field :visible, type: :raw, parse: :json, null: true
      field :press, type: :raw, parse: :json, null: true
      field :change, type: :raw, parse: :json, null: true
      field :padding, type: :string, null: true
      field :margin, type: :string, null: true
      field :background, type: :string, null: true
      field :radius, type: :string, null: true
      field :expand, type: :bool, null: true
      field :align, type: :string, null: true
      field :accessibilityLabel, type: :string, null: true
    end
  end

  node ScreenNode
end
