model UnionSample, storage: :local do
  field :label, type: :string, null: true
  field :attachment, type: MessageAttachment, null: true
  field :props, type: MomentWidgetItemProps, null: true do
    on MomentEmojiProps do
      field :emoji, type: :string
    end
    on MomentLabelProps do
      field :text, type: :string
      field :size, type: :int, null: true
    end
  end
end
