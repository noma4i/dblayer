model UnionSample, storage: :local do
  attribute :label, :string, null: true
  attribute :attachment, RecordAttachment, null: true
  attribute :props, MomentWidgetItemProps, null: true do
    on MomentEmojiProps do
      attribute :emoji, :string
    end
    on MomentLabelProps do
      attribute :text, :string
      attribute :size, :int, null: true
    end
  end
end
