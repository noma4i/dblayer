model Document do
  attribute :slug, :string
  attribute :previewIds, [:id], default: []
  attribute :cover, DocumentCover, null: true, merge: { imageUrl: :non_empty, width: :positive, stage: [[:PENDING, :RUNNING], [:DONE, :FAILED]], progress: :monotonic } do
    attribute :imageUrl, :string, null: true
    attribute :width, :num, null: true
    attribute :stage, :enum, as: CoverStage, null: true
    attribute :progress, :num, null: true
  end
  references :previews, class_name: Record, foreign_key: :previewIds, from: "previews"
  scope :bySlug do
    parameter :slug, :string
    parameter :source, :string
    where slug: :slug
    query "documentBySlug"
    response from: "documentBySlug", shape: :list
    subscribe "documentUpdated"
  end
end
