model Ledger do
  attribute :scope, :string
  index :scope
  operation :create do
    mutation "LedgerCreate"
  end
  operation :update do
    mutation "LedgerUpdate"
  end
  operation :move do
    mutation "LedgerMove"
    parameter :scope, :string
    optimistic false
  end
end

model LedgerFeed do
  attribute :title, :string
  scope :entries do
    parameter :scope, :string
    query "LedgerEntries"
    paginate size: 20, direction: :forward
    edge do
      attribute :impressionUuid, :string, null: true
    end
  end
end

model Shadow do
  attribute :title, :string
  operation :create do
    mutation "ShadowCreate"
  end
  scope :scope do
    query "ShadowScope"
    paginate size: 20, direction: :forward
    edge do
      attribute :score, :int, null: true
    end
  end
  scope :account do
    query "ShadowAccount"
    paginate size: 20, direction: :forward
    edge do
      attribute :rank, :int, null: true
    end
  end
end

model Holder do
  attribute :label, :string, null: true
  scope :account do
    query "AccountProfile"
    response shape: :one
  end
end

model Mailbox do
  attribute :read, :bool
  attribute :put, :string, null: true
  operation :mark do
    mutation "MailboxMark"
    parameter :put, :string
    optimistic false
  end
  scope :entries do
    parameter :act, :string
    query "MailboxEntries"
    paginate size: 20, direction: :forward
    edge do
      attribute :score, :int, null: true
    end
  end
end
