model Ledger do
  attribute :scope, :string
  index :scope
  operation :create, durable: true do
    mutation "CreateMoment"
  end
  operation :update do
    mutation "UpdateMoment"
  end
  operation :move do
    mutation "LikeMoment"
    parameter :scope, :string
    variables scope: :scope
    optimistic false
  end
end

model LedgerFeed do
  attribute :title, :string
  scope :entries do
    parameter :scope, :string
    query "MomentsFeed"
    paginate size: 20, direction: :forward
    edge do
      attribute :impressionUuid, :string, null: true
    end
  end
end

model Shadow do
  attribute :title, :string
  operation :create, durable: true do
    mutation "CreateMoment"
  end
  scope :scope do
    query "MomentsFeed"
    paginate size: 20, direction: :forward
    edge do
      attribute :score, :int, null: true
    end
  end
  scope :account do
    query "MomentsFeed"
    paginate size: 20, direction: :forward
    edge do
      attribute :rank, :int, null: true
    end
  end
end

model Holder do
  attribute :label, :string, null: true
  scope :account do
    query "AccountProfile"
    response shape: :one
  end
end

model Mailbox do
  attribute :read, :bool
  attribute :put, :string, null: true
  operation :mark do
    mutation "LikeMoment"
    parameter :put, :string
    variables put: :put
    optimistic false
  end
  scope :entries do
    parameter :act, :string
    query "MomentsFeed"
    paginate size: 20, direction: :forward
    edge do
      attribute :score, :int, null: true
    end
  end
end
