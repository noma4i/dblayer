model Presence, storage: :memory, expire_after: 1.minute do
  field :userId, type: :id
  field :room, type: :string

  belongs_to :user

  scope :for_user do
    where :userId
  end

  scope :online do
    fetch PresenceOnline
    list
    fresh_for 30.seconds
    updates PresenceChanged, deleted_by: :left
  end
end
