model Presence, storage: :memory, expire_after: 1.minute do
  schema do
    id     :userId, index: true
    string :room
  end

  belongs_to :user, model: User, key: :userId

  scope :for_user, params: [:userId], where: { userId: :userId }

  remote :online do
    query PresenceOnline
    list
    fresh_for 30.seconds
    updates PresenceChanged, deleted_by: :left
  end
end
