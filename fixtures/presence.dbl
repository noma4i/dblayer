model Presence, storage: :memory, expires_in: 1.minute do
  attribute :userId, :id
  attribute :room, :string
  belongs_to :user
  scope :for_user do
    parameter :userId, :id
    where userId: :userId
  end
  scope :online do
    query "PresenceOnline"
    response shape: :list
    freshness expires_in: 30.seconds
    subscribe "PresenceChanged", apply: { effect: :upsert, delete_if: "left" }
  end
end
