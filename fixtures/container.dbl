model Container do
  attribute :title, :string
  attribute :lastRecordAt, :date, derived: true
  attribute :lastRecordId, :id, derived: true
  attribute :lastSequenceNumber, :int, derived: true
  attribute :shareUrl, :string, null: true
  attribute :isPublic, :bool, null: true
  attribute :shelves, [:enum], values: ["PRIMARY", "SECONDARY"], as: ContainerShelf, null: true
  has_many :records, dependent: :destroy
  belongs_to :lastRecord, class_name: Record
  scope :node, node: :one do
    parameter :id, :id
    query "ContainerNode"
    variables id: :id
  end
  changes "RecordEvents", from: "recordEvents.entries", area: "topic", kind: "action", id: "recordId"
  changed_by "CONTAINER", via: :node, removes_on: ["DELETED", "ACCESS_REVOKED"]
  scope :nodes, node: :many do
    query "ContainersByIds"
    response shape: :list
  end
  scope :recent do
    order lastRecordAt: :desc
  end
  scope :shelf, insert_on: :server do
    parameter :shelf, ContainerShelf
    membership shelf: { contains: :shelves }
    query "ContainerShelfQuery"
    response from: "containers", shape: :list
  end
  operation :create do
    mutation "CreateContainer"
  end
  operation :create_photo, upload: true do
    mutation "ContainerGroupCreateFile"
    optimistic false
    response from: "groupContainerCreate.container"
  end
  operation :update_photo, upload: true do
    mutation "ContainerGroupUpdateFile"
    optimistic false
    response from: "groupContainerUpdate.container"
  end
end

model ContainerHit do
  attribute :id, :id, id_from: :container
  attribute :containerId, :id
  belongs_to :container, from: "container"
  scope :search do
    parameter :text, :string
    query "ContainerSearch"
    variables text: :text
    response from: "search.containers", shape: :list
    freshness expires_in: 1.minute
  end
end
