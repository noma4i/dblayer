model Message do
  field :chatId, type: :id
  field :authorId, type: :id
  field :text, type: :string
  field :createdAt, type: :date
  field :sequenceNumber, type: :int, null: true
  field :attachment, type: MessageAttachment, null: true do
    on GiftAttachment do
      field :id, type: :id
      field :tier, type: :string, from: "giftTier"
      field :status, type: :string, null: true
      field :tags, type: [:string], default: []
    end
    on MomentAttachment do
      field :momentId, type: :id
      field :caption, type: :string, null: true
    end
    on ProfileAttachment do
      field :user, type: AttachmentUser, null: true do
        field :id, type: :id
        field :name, type: :string, null: true
      end
    end
    on ReactionAttachment do
      field :body, type: :string
    end
  end

  belongs_to :chat, sets: { lastMessageId: :id, lastMessageAt: :createdAt }, newer: { createdAt: :lastMessageAt }

  scope :by_chat do
    where :chatId
    order createdAt: :asc
  end

  scope :thread, joins: :events do
    order sequenceNumber: :asc_nulls_last, createdAt: :asc
    where :chatId
    fetch ChatThread, root: "chat.messages"
    paginate 30
  end

  operation :create do
    mutation CreateMessage
    input chatId: :chatId, text: :text, signedId: :signedId, attachedUserId: :attachedUserId
    args signedId: :string?, attachedUserId: :id?
    local :authorId
  end

  scope :history do
    fetch ChatMessages
    paginate 30, backward: true
    fresh_for 1.minute, empty: 10.seconds
  end
end
