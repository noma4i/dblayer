model Message do
  schema do
    id     :chatId,    index: true
    id     :authorId
    string :text
    date   :createdAt, index: true
  end

  belongs_to :chat, model: Chat, key: :chatId, sets: { lastMessageId: :id, lastMessageAt: :createdAt }, newer: { createdAt: :lastMessageAt }

  scope :by_chat, params: [:chatId], where: { chatId: :chatId }, order: { createdAt: :asc }

  create with: CreateMessage, input: { chatId: :chatId, text: :text }, local: [:authorId]

  remote :history do
    query ChatMessages
    paginate 30, backward: true
    fresh_for 1.minute, empty: 10.seconds
  end
end
