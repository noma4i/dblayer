model NestedSample, storage: :local do
  field :phase, type: :enum, values: [:draft, :live], null: true
  field :value, type: NestedValue, null: true do
    field :title, type: :string
    field :note, type: :string, optional: true
    field :nullableDefault, type: :string, optional: true, default: "default"
    field :ownerId, type: :id, null: true, from: "owner_id"
    field :count, type: :int, default: 2
    field :ratio, type: :num, default: 1.5
    field :enabled, type: :bool, default: false
    field :createdAt, type: :date, null: true
    field :state, type: :enum, values: [:ready, :done], default: :ready
    field :labels, type: [:string], default: []
    field :counts, type: [:int], default: []
    field :ratios, type: [:num], default: []
    field :flags, type: [:bool], default: []
    field :dates, type: [:date], default: []
    field :owners, type: [:id], default: []
    field :payload, type: :raw, null: true
    field :rawValue, type: :raw, default: { free: [1, true, nil] }
    field :preferences, type: :object, default: { label: "base" } do
      field :label, type: :string
      field :active, type: :bool, default: true
    end
    field :presets, type: [NestedValuePreferences], default: [{ label: "first" }]
    field :metadata, type: :object, null: true
    field :values, type: :array, null: true
    field :child, type: :object, null: true do
      field :body, type: :string, null: true
      field :horizontal, type: :num, from: "x", default: 0
    end
    field :children, type: [NestedValueChild], default: []
  end
  field :values, type: [NestedValue], default: []
  field :tree, type: NestedTree, null: true do
    field :name, type: :string
    field :children, type: [NestedTree], default: []
  end
  field :replyTo, type: MessageReplyNode, null: true do
    field :id, type: :id, null: true
    field :body, type: :string, null: true
    field :kind, type: :string, null: true
    field :userId, type: :id, null: true
    field :user, type: MessageUserRef, null: true do
      field :id, type: :id, null: true
      field :fullName, type: :string, null: true
      field :name, type: :string, null: true
      field :username, type: :string, null: true
      field :avatarUrl, type: :string, null: true
    end
    field :media, type: NestedMedia, null: true do
      field :id, type: :id, default: ""
      field :fileUrl, type: :string, null: true
    end
  end
end
