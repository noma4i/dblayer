model NestedSample, storage: :local do
  attribute :phase, :enum, values: ["draft", "live"], null: true
  attribute :value, NestedValue, null: true do
    attribute :title, :string
    attribute :note, :string, optional: true
    attribute :nullableDefault, :string, null: true, default: "default"
    attribute :ownerId, :id, null: true, from: "owner_id"
    attribute :count, :int, default: 2
    attribute :ratio, :num, default: 1.5
    attribute :enabled, :bool, default: false
    attribute :createdAt, :date, null: true
    attribute :state, :enum, values: ["ready", "done"], default: :ready
    attribute :labels, [:string], default: []
    attribute :counts, [:int], default: []
    attribute :ratios, [:num], default: []
    attribute :flags, [:bool], default: []
    attribute :dates, [:date], default: []
    attribute :owners, [:id], default: []
    attribute :payload, :json, null: true
    attribute :rawValue, :json, default: { free: [1, true, nil] }
    attribute :preferences, NestedValuePreferences, default: { label: "base" } do
      attribute :label, :string
      attribute :active, :bool, default: true
    end
    attribute :presets, [NestedValuePreferences], default: [{ label: "first" }]
    attribute :metadata, :json, null: true
    attribute :values, :json, null: true
    attribute :child, NestedValueChild, null: true do
      attribute :body, :string, null: true
      attribute :horizontal, :num, from: "x", default: 0
    end
    attribute :children, [NestedValueChild], default: []
  end
  attribute :values, [NestedValue], default: []
  attribute :tree, NestedTree, null: true do
    attribute :name, :string
    attribute :children, [NestedTree], default: []
  end
  attribute :replyTo, RecordReplyNode, null: true do
    attribute :id, :id, null: true
    attribute :body, :string, null: true
    attribute :kind, :string, null: true
    attribute :userId, :id, null: true
    attribute :user, RecordUserRef, null: true do
      attribute :id, :id, null: true
      attribute :fullName, :string, null: true
      attribute :name, :string, null: true
      attribute :username, :string, null: true
      attribute :avatarUrl, :string, null: true
    end
    attribute :media, NestedMedia, null: true do
      attribute :id, :id, default: ""
      attribute :fileUrl, :string, null: true
    end
  end
end
