model InterfaceRecord do
  attribute :slug, :string
  attribute :spec, SampleSpec, null: true do
    attribute :root, :id
    attribute :elements, [SampleElement] do
      shared do
        attribute :id, :id
        attribute :children, [:id]
        attribute :press, SampleAction, null: true do
          on SampleNavigateAction do
            attribute :slug, :string
            attribute :title, :string, null: true
          end
          on SampleOpenRecordAction do
            attribute :recordId, :string
          end
          on SampleOpenExternalAction do
            attribute :url, :string
          end
          on SampleOpenProfileAction do
            attribute :userId, :string
          end
        end
        attribute :visible, SampleVisibility, null: true do
          on SampleCondition do
            attribute :comparison, :string
            attribute :negated, :bool
            attribute :operand, SampleOperand, null: true do
              on SampleFlagLiteral do
                attribute :flag, :bool
              end
              on SampleNumberLiteral do
                attribute :number, :num
              end
              on SampleStateRef do
                attribute :path, :string
              end
              on SampleTextLiteral do
                attribute :text, :string
              end
            end
            attribute :path, :string
          end
          on SampleVisibleAll do
            attribute :conditions, [SampleCondition]
          end
          on SampleVisibleAny do
            attribute :conditions, [SampleCondition]
          end
          on SampleVisibleFlag do
            attribute :flag, :bool
          end
        end
      end
      on SampleButton do
        attribute :label, SampleTextValue, null: true do
          on SampleStateRef
          on SampleTextLiteral
        end
        attribute :disabled, SampleFlagValue, null: true do
          on SampleFlagLiteral
          on SampleStateRef
        end
      end
      on SampleColumn do
        attribute :gap, SampleNumberValue, null: true do
          on SampleNumberLiteral
          on SampleStateRef
        end
        attribute :alignItems, :string, null: true
      end
      on SampleHeading do
        attribute :text, SampleTextValue, null: true
        attribute :level, :int, null: true
      end
      on SamplePressable do
      end
      on SampleSpacer do
        attribute :length, SampleNumberValue, null: true
      end
      on SampleSwitch do
        attribute :checked, SampleFlagValue, null: true
        attribute :label, SampleTextValue, null: true
      end
    end
    attribute :state, [SampleStateEntry] do
      attribute :path, :string
      attribute :value, SampleStateValue do
        on SampleFlagLiteral
        on SampleNumberLiteral
        on SampleTextLiteral
      end
    end
  end
  scope :node, node: :one do
    parameter :id, :id
    query "SampleNode"
    variables id: :id
  end
end
