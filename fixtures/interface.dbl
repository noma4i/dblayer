model InterfaceRecord do
  field :slug, type: :string
  field :spec, type: SampleSpec, null: true do
    field :root, type: :id
    field :elements, type: [SampleElement] do
      shared do
        field :id, type: :id
        field :children, type: [:id]
        field :press, type: SampleAction, null: true do
          on SampleNavigateAction do
            field :slug, type: :string
            field :title, type: :string, null: true
          end
          on SampleOpenRecordAction do
            field :recordId, type: :string
          end
          on SampleOpenExternalAction do
            field :url, type: :string
          end
          on SampleOpenProfileAction do
            field :userId, type: :string
          end
        end
        field :visible, type: SampleVisibility, null: true do
          on SampleCondition do
            field :comparison, type: :string
            field :negated, type: :bool
            field :operand, type: SampleOperand, null: true do
              on SampleFlagLiteral do
                field :flag, type: :bool
              end
              on SampleNumberLiteral do
                field :number, type: :num
              end
              on SampleStateRef do
                field :path, type: :string
              end
              on SampleTextLiteral do
                field :text, type: :string
              end
            end
            field :path, type: :string
          end
          on SampleVisibleAll do
            field :conditions, type: [SampleCondition]
          end
          on SampleVisibleAny do
            field :conditions, type: [SampleCondition]
          end
          on SampleVisibleFlag do
            field :flag, type: :bool
          end
        end
      end
      on SampleButton do
        field :label, type: SampleTextValue, null: true do
          on SampleStateRef
          on SampleTextLiteral
        end
        field :disabled, type: SampleFlagValue, null: true do
          on SampleFlagLiteral
          on SampleStateRef
        end
      end
      on SampleColumn do
        field :gap, type: SampleNumberValue, null: true do
          on SampleNumberLiteral
          on SampleStateRef
        end
        field :alignItems, type: :string, null: true
      end
      on SampleHeading do
        field :text, type: SampleTextValue, null: true
        field :level, type: :int, null: true
      end
      on SamplePressable do
      end
      on SampleSpacer do
        field :length, type: SampleNumberValue, null: true
      end
      on SampleSwitch do
        field :checked, type: SampleFlagValue, null: true
        field :label, type: SampleTextValue, null: true
      end
    end
    field :state, type: [SampleStateEntry] do
      field :path, type: :string
      field :value, type: SampleStateValue do
        on SampleFlagLiteral
        on SampleNumberLiteral
        on SampleTextLiteral
      end
    end
  end

  node SampleNode
end
