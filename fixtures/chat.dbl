model Chat do
  field :title, type: :string
  field :lastMessageAt, type: :date, null: true
  field :lastMessageId, type: :id, null: true
  field :shareUrl, type: :string, null: true
  field :isPublic, type: :bool, null: true
  field :shelves, type: [:enum], values: [:PRIMARY, :SECONDARY], as: ChatShelf, null: true

  has_many   :messages, dependent: :destroy
  belongs_to :lastMessage, model: Message

  node ChatNode
  nodes ChatsByIds

  scope :recent do
    order lastMessageAt: :desc
  end

  operation :create do
    mutation CreateChat
  end

  operation :create_photo do
    upload ChatGroupCreateFile
    local_effect :none, reason: "the pending row is created with its photo"
    root "groupChatCreate.chat"
  end

  operation :update_photo do
    upload ChatGroupUpdateFile
    local_effect :none, reason: "the answer updates the existing photo"
    root "groupChatUpdate.chat"
  end
end
